# Copy this file to .env and fill in your real values.
# WARNING: Never commit .env to version control!

# Gemini API key — obtainable from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# How many days before P.I.S.T.A. flags an order as "stuck"
PISTA_STUCK_ORDER_DAYS=3

# Cost protection: Abort API calls if the prompt exceeds this many tokens
PISTA_MAX_TOKENS_PER_REQUEST=20000

# Gmail API credentials for the Email Robot (server/email-robot.js)
# Create OAuth2 credentials in Google Cloud Console and authorize with the
# gmail.modify scope so the robot can apply the "pista" label.
# IMPORTANT: The refresh token is long-lived — treat it like a password.
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
